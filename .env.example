# ═══════════════════════════════════════════════
# Outbound OS — Environment Configuration
# ═══════════════════════════════════════════════
# cp .env.example .env

# ── Database ──
DATABASE_URL="file:../data/outboundos.db"
# The checked-in Prisma schema uses SQLite. Changing database engines requires
# a separate schema and reviewed migration; changing only this URL will fail.

# ── Your business ──
BUSINESS_NAME=
BUSINESS_WEBSITE=
# When "today" starts for daily limits, reports and schedules. IANA name,
# e.g. Europe/London, America/New_York, Asia/Kolkata.
BUSINESS_TIMEZONE=UTC
# Calling code added to numbers entered without one (1 = US/Canada, 44 = UK,
# 91 = India). Blank: numbers are used exactly as entered.
DEFAULT_COUNTRY_CODE=
# Links and signature used in outreach emails. Blank ones are left out.
BUSINESS_WHATSAPP_NUMBER=
BUSINESS_CATALOGUE_URL=
EMAIL_SIGNATURE_NAME=
EMAIL_FOOTER_NOTE=

# ── Server ──
API_PORT=3001
# Proxies allowed to report the client's address. Default covers a proxy on
# this machine or a private network; behind a CDN use its hop count, e.g. 2.
TRUST_PROXY=
NODE_ENV=production

# ── Authentication ──
# local (default): email + password stored in this database. The first admin
# is created on first boot from ADMIN_EMAIL / ADMIN_PASSWORD; if no password
# is set, a random one is printed to the log once.
# clerk: Clerk-hosted sign-in. Set AUTH_PROVIDER=clerk plus both Clerk keys.
AUTH_PROVIDER=local
ADMIN_EMAIL=
ADMIN_PASSWORD=
CLERK_SECRET_KEY=

# Signs sign-in sessions. Leave blank and a random value is generated on first
# boot and kept in data/instance-secrets.json beside the database.
JWT_SECRET=

# Static service token for the MCP server (mcp-outboundos/) to call this API
# without a Clerk session — must match MCP_SERVICE_TOKEN in mcp-outboundos/.env.
# Generate with: openssl rand -hex 32
MCP_SERVICE_TOKEN=
# Only for the MCP server (docker compose --profile mcp up -d). The token AI
# clients send as "Authorization: Bearer <token>"; also the password on the
# sign-in step when claude.ai connects by OAuth, unless OAUTH_PASSWORD is set.
# Generate with: openssl rand -hex 32
MCP_BEARER_TOKEN=
OAUTH_PASSWORD=

# ── Restart / wake recovery ──
RUNTIME_RECOVERY_ENABLED=true
RUNTIME_HEARTBEAT_SECONDS=60
RUNTIME_WAKE_GAP_SECONDS=180
RUNTIME_RECOVERY_OVERLAP_MINUTES=15
RUNTIME_INITIAL_LOOKBACK_HOURS=24
RUNTIME_RECONCILE_INTERVAL_MINUTES=5
# After a restart or sleep, reconcile any first-touch message that was
# interrupted mid-queue. The database automation key stops double sends.

# ── WhatsApp ──
# Numbers are connected per account in Settings → WhatsApp, choosing Meta's
# Cloud API (recommended) or AiSensy. The values below are only needed for
# receiving Meta webhooks, or as a single-number fallback.

# Meta Cloud API. Webhook callback URL: https://<your host>/webhook/meta
META_APP_SECRET=
# Any random string; paste the same value into the Meta webhook form.
META_WEBHOOK_VERIFY_TOKEN=
# Optional single-number fallback when no account has its own credentials.
META_PHONE_NUMBER_ID=
META_ACCESS_TOKEN=
META_TEMPLATE_LANGUAGE=en
# Template for a new lead's first WhatsApp message when a number has no
# default of its own. Blank: skip WhatsApp for first contact on those numbers.
WA_FIRST_TOUCH_TEMPLATE=

# AiSensy (optional).
AISENSY_CAMPAIGN_API_KEY=
AISENSY_FOLLOWUP_CAMPAIGN_NAME=Follow-up
AISENSY_WEBHOOK_SECRET=
WA_WARMUP_WEEK=1
# 1-8, controls daily message ramp-up
WA_MAX_DAILY=50
WA_MAX_HOURLY=8
WA_MIN_DELAY=30000
WA_MAX_DELAY=90000
# milliseconds between messages (anti-ban)

# ── Email ──
# Email accounts are configured via the dashboard Settings page.
# SMTP/IMAP credentials are AES-256-GCM encrypted in the database.
# Daily promotional campaigns require a public HTTPS endpoint for Brevo event
# callbacks. Set both values before enabling campaign delivery; configure the
# resulting ${BREVO_WEBHOOK_PUBLIC_URL}/webhook/brevo URL in Brevo as well.
BREVO_WEBHOOK_PUBLIC_URL=
BREVO_WEBHOOK_SECRET=


# ── Encryption ──
# Encrypts stored channel credentials (email, WhatsApp, iMessage). Leave blank
# to have one generated into data/instance-secrets.json on first boot. If you
# set it yourself, keep it: changing it makes saved credentials unreadable.
LEAD_SYNC_ENCRYPTION_KEY=

# ── iMessage / BlueBubbles ──
# Configure the server URL and password in Dashboard > Settings > iMessage.
IMESSAGE_WEBHOOK_SECRET=
# Append this secret to the BlueBubbles webhook URL as ?token=<secret>&accountId=<id>.

# ── Instance identity (Docker Compose / multi-instance) ──
# INSTANCE_NAME=default   # shown in logs and /healthz

# ── Order notification campaigns (AiSensy) ───────────────────────────────────
# AiSensy addresses a *campaign*, which wraps the approved template. Passing a
# template name returns "Campaign does not exist". Create a campaign per
# template and put its name here.
WA_CAMPAIGN_ORDER_CONFIRMED=Order Confirmed
WA_CAMPAIGN_ORDER_SHIPPED=Order Shipped
WA_CAMPAIGN_ORDER_DELIVERED=Order Delivered

# ── Clerk (session auth + Organizations) ─────────────────────────────────────
# Dashboard: https://dashboard.clerk.com
# CLERK_SECRET_KEY is backend-only, read by src/auth/clerkAuth.js — never expose
# it to the frontend. The matching frontend var (VITE_CLERK_PUBLISHABLE_KEY)
# lives in web/.env.local, not here, since Vite only reads its own directory.
CLERK_PUBLISHABLE_KEY=
